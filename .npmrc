# pnpm compatibility settings for BunnyMetrics.
#
# node-linker=hoisted makes pnpm lay out node_modules flat, the same way npm
# does. This is required because `eslint-config-next` patches ESLint internals
# at load time and its patch only succeeds when eslint and the config resolve
# from the same top-level node_modules. Under pnpm's default isolated layout the
# patch fails with:
#   "Failed to patch ESLint because the calling module was not recognized."
# Remove this once the ESLint integration supports isolated installs.
node-linker=hoisted
