# ---------------------------------------------------------------------------
# BunnyMetrics environment configuration
# Copy to `.env` and fill in. Every value below has a safe dev default.
# ---------------------------------------------------------------------------

# Public origin of this app (used for auth callbacks + absolute script URLs)
NEXTAUTH_URL="http://localhost:3000"
# Secret used to sign NextAuth JWTs. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="dev-secret-change-me-please-generate-a-real-one"

# Prisma connection string. SQLite by default.
DATABASE_URL="file:./dev.db"

# Stripe (mock mode by default — no keys required to run the app)
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PRICE_HOBBY=""
NEXT_PUBLIC_STRIPE_PRICE_PRO=""

# Public app URL, embedded in the copy-paste tracking snippet
NEXT_PUBLIC_APP_URL="http://localhost:3000"
