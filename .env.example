# ---------------------------------------------------------------------------
# BunnyMetrics environment configuration
# Copy to `.env` and fill in. Every value below has a safe dev default.
# ---------------------------------------------------------------------------

# Public origin of this app (used for auth callbacks + absolute script URLs)
NEXTAUTH_URL="http://localhost:3000"
# Secret used to sign NextAuth JWTs. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="dev-secret-change-me-please-generate-a-real-one"

# --- Database ---------------------------------------------------------------
# Local SQLite. Used by the Prisma CLI (db push / db seed) and by the app
# whenever TURSO_DATABASE_URL is absent, which is the case in CI and in
# `scripts/verify.sh`.
DATABASE_URL="file:./dev.db"

# Turso / libSQL. When TURSO_DATABASE_URL is set, lib/prisma.ts routes every
# query through the libSQL driver adapter instead of the classic engine. Turso
# speaks the SQLite dialect, so no query changes.
#   turso db create bunnymetrics-preview
#   turso db show bunnymetrics-preview --url
#   turso db tokens create bunnymetrics-preview
# Leave TURSO_DATABASE_URL empty to run fully local.
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""

# --- Stripe (mock mode by default — no keys required to run the app) --------
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PRICE_HOBBY=""
NEXT_PUBLIC_STRIPE_PRICE_PRO=""

# Public app URL, embedded in the copy-paste tracking snippet
NEXT_PUBLIC_APP_URL="http://localhost:3000"
