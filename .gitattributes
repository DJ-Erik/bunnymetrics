# Normalise line endings in the repository, and check out LF by default.
# Without this, a Windows checkout rewrites shell scripts with CRLF and
# `scripts/verify.sh` dies on Linux with:
#   bad interpreter: /usr/bin/env bash^M
* text=auto eol=lf

# Never touch line endings in these.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary

# Native Windows scripts legitimately use CRLF.
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Keep the lockfile diff-friendly and avoid pnpm rewriting it.
pnpm-lock.yaml -diff
